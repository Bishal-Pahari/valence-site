---
import Base from '../layouts/Base.astro';
import { AUTHOR, DOCS_REPO, GA_ID, REPO } from '../site.config.mjs';

const updated = '16 October 2026';
const analytics = GA_ID !== '';
---

<Base
  title="Privacy policy | Valence"
  description="What the Valence website collects, what it does not, and how to opt out of analytics."
  path="/privacy/"
  ogKey="privacy"
  ogAlt="Valence privacy policy"
>
  <section class="legal">
    <div class="wrap legal-wrap">
      <span class="eyebrow">Privacy policy</span>
      <h1>What this website collects</h1>
      <p class="muted">Last updated {updated}</p>

      <p class="lede">
        This website describes Valence, an open-source tool for shipping a web app inside a Flutter app. It has no accounts, no forms and no
        advertising. {analytics
          ? 'It uses Google Analytics only if you agree.'
          : 'It does not currently use analytics or cookies.'}
      </p>

      <h2>Who is responsible</h2>
      <p>
        {AUTHOR} runs this website. Questions about this policy can be raised as an issue in the{' '}
        <a class="link" href={`${DOCS_REPO}/issues`}>website repository</a>.
      </p>

      <h2>What you send when you visit</h2>
      <p>
        Like any web server, the host that serves this site receives your IP address, the page you asked for, your browser's user agent and the
        time of the request. The host uses this to deliver the page and to protect against abuse, and keeps it in short-lived server logs. This
        site does not combine it with anything else.
      </p>

      {analytics ? (
        <Fragment>
          <h2>Analytics</h2>
          <p>
            If you press <strong>Accept analytics</strong>, this site loads Google Analytics 4 (measurement ID <code>{GA_ID}</code>), operated by
            Google. It sets the cookies <code>_ga</code> and <code>_ga_*</code> and sends Google the pages you view, your approximate location
            (derived from your IP address, which is anonymised), your device and browser type, and how long you stay. It is used to see which pages
            of the documentation are read and where people leave.
          </p>
          <ul>
            <li>Nothing from Google Analytics is loaded until you accept.</li>
            <li>
              If you press <strong>Decline</strong>, or ignore the banner, no analytics code runs and no analytics cookies are set.
            </li>
            <li>
              You can change your mind at any time with <button type="button" class="linklike" data-consent-open>Cookie settings</button> in the footer.
              Declining after accepting stops measurement and removes the analytics cookies.
            </li>
            <li>Your choice is stored in your browser (localStorage key <code>valence-consent</code>), not on a server.</li>
          </ul>
          <p>
            Google processes this data under its own terms and may transfer it outside your country. See{' '}
            <a class="link" href="https://policies.google.com/technologies/partner-sites">how Google uses information from sites that use its services</a>.
            The legal basis is your consent, which you can withdraw as described above.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h2>Analytics and cookies</h2>
          <p>This site sets no cookies and runs no analytics. If that changes, this page will be updated first and a consent banner will appear.</p>
        </Fragment>
      )}

      <h2>Fonts and other third parties</h2>
      <p>
        Pages load the typefaces Google Sans and Reddit Mono from Google Fonts, so your browser contacts Google's font servers when a page loads.
        This happens without cookies. Links to GitHub and other sites are ordinary links: they leave this site and follow those sites' policies.
      </p>

      <h2>Your rights</h2>
      <p>
        Depending on where you live, you may have the right to ask what data is held about you, to have it corrected or deleted, and to object to
        processing. This site holds no account data. For data held by Google Analytics, use Google's own tools and your Google account controls.
      </p>

      <h2>Changes</h2>
      <p>
        When this policy changes, the date above changes with it. The history is public in the{' '}
        <a class="link" href={`${DOCS_REPO}/commits/main/src/pages/privacy.astro`}>website repository</a>. For the software itself, see the{' '}
        <a class="link" href={REPO}>Valence repository</a>.
      </p>
      <p><a class="link" href="/">Back to the home page</a> · <a class="link" href="/docs/">Read the docs</a></p>
    </div>
  </section>
</Base>

<style is:global>
  .legal { padding-block: clamp(56px, 8vw, 112px); }
  .legal-wrap { max-width: 800px; display: grid; gap: 18px; }
  .legal h1 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.025em; line-height: 1.1; }
  .legal h2 { font-size: 1.35rem; letter-spacing: -0.015em; margin-top: 18px; }
  .legal ul { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .legal p, .legal li { max-width: 68ch; }
  .legal .linklike { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
</style>
