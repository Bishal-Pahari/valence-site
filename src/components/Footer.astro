---
import { AUTHOR, GA_ID, ISSUES, REPO } from '../site.config.mjs';
---

<footer>
  <div class="wrap">
    <span>Valence · beta · MIT © 2026 {AUTHOR}</span>
    <nav aria-label="Footer">
      <a href="/docs/">Docs</a> · <a href="/docs/getting-started/quick-start/">Quick start</a> · <a href="/docs/getting-started/beta/">Beta status</a> ·{' '}
      <a href={ISSUES}>Report a problem</a> · <a href="/privacy/">Privacy</a> · <a href={REPO}>GitHub</a>
      {GA_ID && <Fragment> · <button type="button" class="linklike" data-consent-open>Cookie settings</button></Fragment>}
    </nav>
  </div>
</footer>

<style>
  .linklike { background: none; border: 0; padding: 0; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .linklike:hover { color: var(--heading); }
</style>
