---
import Default from '@astrojs/starlight/components/Footer.astro';

import { GA_ID, ISSUES } from '../site.config.mjs';
---

<Default {...Astro.props}><slot /></Default>
<nav class="site-links" aria-label="Site">
  <a href="/">Home</a>
  <a href={ISSUES}>Report a problem</a>
  <a href="/privacy/">Privacy</a>
  {GA_ID && <button type="button" data-consent-open>Cookie settings</button>}
</nav>

<style>
  .site-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 1rem; font-size: var(--sl-text-sm); }
  .site-links a, .site-links button { color: var(--sl-color-gray-3); background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .site-links a:hover, .site-links button:hover { color: var(--sl-color-white); }
</style>
